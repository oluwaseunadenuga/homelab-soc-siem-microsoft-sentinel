// Enrich failed authentication events with Sentinel GeoIP Watchlist data
let GeoIPDB_FULL = _GetWatchlist("geoip");

let WindowsEvents =
    SecurityEvent
    | where IpAddress == "<ATTACKER_IP>"
    | where EventID == 4625
    | order by TimeGenerated desc
    | evaluate ipv4_lookup(
        GeoIPDB_FULL,
        IpAddress,
        network
    );

WindowsEvents
